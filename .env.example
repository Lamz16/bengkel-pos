# ==============================================================================
# BENGKELPRO POS & WORKSHOP MANAGEMENT - KONFIGURASI ENVIRONMENT
# ==============================================================================

# Database Connection URL untuk PostgreSQL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/bengkelpro?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bengkelpro?schema=public"

# Rahasia penandatangan JWT. Gunakan nilai acak minimal 32 karakter dan jangan commit nilai produksi.
JWT_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"
npm
# Kredensial Owner pertama. Wajib hanya ketika menjalankan `npm run db:seed`
# pada database tanpa akun pengguna. Seeder tidak mengubah atau menambah akun
# bila satu akun saja sudah ada. Jangan commit kredensial sebenarnya.
INITIAL_OWNER_NAME="Nama Pemilik"
INITIAL_OWNER_EMAIL="owner@contoh.invalid"
INITIAL_OWNER_PASSWORD="ganti-dengan-password-kuat-minimal-8-karakter"

# Masukkan Google Gemini API Key di sini (Opsional untuk diagnosa otomatis cerdas)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port server backend Express (default: 3000)
PORT=3000
