# ==============================================================================
# BENGKELPRO POS & WORKSHOP MANAGEMENT - KONFIGURASI ENVIRONMENT
# ==============================================================================

# Database Connection URL untuk PostgreSQL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/bengkelpro?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bengkelpro?schema=public"

# Masukkan Google Gemini API Key di sini (Opsional untuk diagnosa otomatis cerdas)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port server backend Express (default: 3000)
PORT=3000

