datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CompanySettings {
  id                             String   @id @default("settings-default")
  name                           String   @default("BengkelPro Mandiri")
  logoUrl                        String?
  slogan                         String   @default("Solusi Perawatan & Servis Terpercaya")
  address                        String   @default("Jl. Otomotif Raya No. 123, Blok B4, Jakarta Selatan")
  phone                          String   @default("0812-3456-7890")
  email                          String?  @default("kontak@bengkelpro.com")
  operationalHours               String?  @default("Senin - Sabtu: 08:00 - 17:00 WIB")
  ownerName                      String?  @default("Pemilik Bengkel")
  picName                        String?  @default("Rian Herlambang")
  defaultMechanicBonusPercent    Float    @default(15)
  defaultAbsencePenalty          Decimal  @default(50000) @db.Decimal(18, 2)
  defaultWarrantyPenalty         Decimal  @default(75000) @db.Decimal(18, 2)
  allowCustomBonusPerTransaction Boolean  @default(true)
  receiptHeader                  String?  @default("NOTA RESMI & RINCIAN SERVIS")
  footerNote                     String   @default("Barang yang sudah dibeli tidak dapat ditukar kecuali perjanjian. Terima kasih atas kepercayaan Anda merawat kendaraan bersama kami.")
  warrantyTerms                  String   @default("Garansi servis 7 hari atau 500 KM untuk pengerjaan perbaikan yang sama dengan menunjukkan nota ini.")
  showMechanicOnReceipt          Boolean  @default(true)
  showWarrantyOnReceipt          Boolean  @default(true)
  showOdometerOnReceipt          Boolean  @default(true)
  showCustomerPhoneOnReceipt     Boolean  @default(true)
  receiptContactHelp             String?  @default("WhatsApp CS: 0812-3456-7890")
  loyaltySilverVisits            Int?     @default(3)
  loyaltyGoldVisits              Int?     @default(6)
  loyaltyVipVisits               Int?     @default(10)
  loyaltySilverDiscountPercent   Float?   @default(5)
  loyaltyGoldDiscountPercent     Float?   @default(10)
  loyaltyVipDiscountPercent      Float?   @default(15)
  updatedAt                      DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  name         String
  role         String   @default("Admin") // "Owner" | "Admin"
  email        String   @unique
  password     String
  workshopName String   @default("BengkelPro Mandiri")
  status       String   @default("Active")
  shifts       String?  @default("Pagi")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                String            @id @default(uuid())
  name              String
  phone             String
  totalServiceCount Int               @default(0)
  totalSpent        Decimal           @default(0) @db.Decimal(18, 2)
  lastVisitDate     DateTime?
  loyaltyTier       String?           @default("Bronze")
  notes             String?
  version           Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  vehicles          Vehicle[]
  services          WorkshopService[]
}

model Vehicle {
  id          String            @id @default(uuid())
  customerId  String
  plateNumber String
  model       String
  brand       String
  createdAt   DateTime          @default(now())
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  services    WorkshopService[]
}

model SparePart {
  id               String                   @id @default(uuid())
  sku              String?                  @unique
  barcode          String?
  name             String
  categoryId       String
  productId        String
  variantName      String                   @default("Standar")
  size             String                   @default("")
  price            Decimal                  @db.Decimal(18, 2)
  purchasePrice    Decimal                  @default(0) @db.Decimal(18, 2)
  stock            Int                      @default(0)
  minStock         Int                      @default(5)
  supplierId       String?
  imageUrl         String?
  rackId           String?
  shelfLevel       String?
  binNumber        String?
  locationNotes    String?
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  supplier         Supplier?                @relation(fields: [supplierId], references: [id])
  category         PartCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  rack             WarehouseRack?           @relation(fields: [rackId], references: [id], onDelete: Restrict)
  serviceItems     ServicePartItem[]
  purchases        PurchaseRecord[]
  stockHistories   StockHistory[]
  distributorItems DistributorInvoiceItem[]

  @@index([categoryId])
  @@index([productId])
  @@index([rackId])
  @@index([supplierId])
  @@index([rackId, shelfLevel, binNumber])
  @@unique([productId, variantName, size])
}

// Produk adalah data induk; setiap SparePart merupakan stok satu variasi yang
// memiliki SKU, ukuran, harga, dan lokasi rak sendiri.
model Product {
  id         String       @id @default(uuid())
  name       String
  categoryId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   PartCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   SparePart[]

  @@unique([name, categoryId])
  @@index([categoryId, name])
}

model PartCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  skuPrefix   String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parts       SparePart[]
  products    Product[]
}

model WarehouseZone {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  racks       WarehouseRack[]
}

model WarehouseRack {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  zoneId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  zone        WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  parts       SparePart[]

  @@index([zoneId])
}

model WorkshopService {
  id                      String            @id @default(uuid())
  customerId              String?
  customerName            String
  customerPhone           String?
  vehicleId               String?
  vehiclePlate            String
  vehicleModel            String
  kilometers              Int               @default(0)
  serviceType             String            @default("Servis Rutin")
  complaint               String
  diagnosis               String?
  status                  String            @default("In Progress") // "Pending" | "In Progress" | "Ready" | "Done"
  laborFee                Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount             Decimal           @default(0) @db.Decimal(18, 2)
  paymentStatus           String            @default("Unpaid") // "Unpaid" | "Paid"
  discountAmount          Decimal?          @default(0) @db.Decimal(18, 2)
  discountReason          String?
  mechanicId              String?
  mechanicName            String?
  mechanicBonusPercent    Float?            @default(0)
  mechanicBonusAmount     Decimal?          @default(0) @db.Decimal(18, 2)
  hasWarrantyClaim        Boolean           @default(false)
  warrantyClaimDate       DateTime?
  warrantyClaimReason     String?
  isMechanicAbsentOnClaim Boolean?          @default(false)
  warrantyDeductionAmount Decimal?          @default(0) @db.Decimal(18, 2)
  version                 Int               @default(1)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  customer                Customer?         @relation(fields: [customerId], references: [id])
  vehicle                 Vehicle?          @relation(fields: [vehicleId], references: [id])
  mechanic                Mechanic?         @relation(fields: [mechanicId], references: [id])
  partsUsed               ServicePartItem[]
}

model ServicePartItem {
  id          String          @id @default(uuid())
  serviceId   String
  partId      String
  name        String
  quantity    Int             @default(1)
  priceAtTime Decimal         @db.Decimal(18, 2)
  service     WorkshopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  part        SparePart       @relation(fields: [partId], references: [id])
}

model Mechanic {
  id                    String               @id @default(uuid())
  name                  String
  phone                 String
  specialty             String
  status                String               @default("Active")
  defaultBonusPercent   Float                @default(15)
  dailySalary           Decimal              @default(100000) @db.Decimal(18, 2)
  warrantyPenaltyAmount Decimal              @default(75000) @db.Decimal(18, 2)
  absencePenaltyAmount  Decimal              @default(50000) @db.Decimal(18, 2)
  joinedAt              String               @default("2024-01-10")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deductions            MechanicDeduction[]
  attendances           MechanicAttendance[]
  services              WorkshopService[]
}

model MechanicDeduction {
  id              String   @id @default(uuid())
  mechanicId      String
  mechanicName    String
  serviceId       String?
  vehiclePlate    String?
  date            DateTime @default(now())
  reason          String
  type            String   @default("Warranty_Complaint")
  amount          Decimal  @db.Decimal(18, 2)
  isAbsentNextDay Boolean  @default(false)
  mechanic        Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
}

model MechanicAttendance {
  id         String   @id @default(uuid())
  mechanicId String
  date       String
  status     String   @default("Present")
  notes      String?
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
}

model Supplier {
  id                  String               @id @default(uuid())
  name                String
  contact             String
  address             String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  parts               SparePart[]
  purchases           PurchaseRecord[]
  distributorInvoices DistributorInvoice[]
}

model PurchaseRecord {
  id         String    @id @default(uuid())
  partId     String
  supplierId String
  quantity   Int
  costPrice  Decimal   @db.Decimal(18, 2)
  date       DateTime  @default(now())
  part       SparePart @relation(fields: [partId], references: [id])
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
}

model Expense {
  id        String   @id @default(uuid())
  category  String
  amount    Decimal  @db.Decimal(18, 2)
  note      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model StockHistory {
  id       String     @id @default(uuid())
  partId   String
  partName String
  amount   Int
  type     String // "In" | "Out"
  reason   String
  date     DateTime   @default(now())
  part     SparePart? @relation(fields: [partId], references: [id])
}

model DistributorInvoice {
  id              String                   @id @default(uuid())
  invoiceNumber   String                   @unique
  supplierId      String?
  supplierName    String
  branchName      String                   @default("Bengkel Pusat")
  branchType      String                   @default("Pusat") // "Pusat" | "Cabang"
  totalAmount     Decimal                  @db.Decimal(18, 2)
  paidAmount      Decimal                  @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal                  @db.Decimal(18, 2)
  issueDate       DateTime                 @default(now())
  dueDate         DateTime
  status          String                   @default("Unpaid") // "Unpaid" | "Partial" | "Paid" | "Overdue"
  paymentMethod   String?                  @default("Transfer")
  notes           String?
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  supplier        Supplier?                @relation(fields: [supplierId], references: [id])
  items           DistributorInvoiceItem[]
  payments        DistributorPayment[]

  @@index([dueDate])
  @@index([issueDate])
  @@index([branchName])
  @@index([status])
  @@index([supplierId])
}

model DistributorInvoiceItem {
  id         String             @id @default(uuid())
  invoiceId  String
  partId     String?
  partName   String
  quantity   Int                @default(1)
  unitPrice  Decimal            @db.Decimal(18, 2)
  totalPrice Decimal            @db.Decimal(18, 2)
  invoice    DistributorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part       SparePart?         @relation(fields: [partId], references: [id])

  @@index([invoiceId])
  @@index([partId])
}

model DistributorPayment {
  id            String             @id @default(uuid())
  invoiceId     String
  amount        Decimal            @db.Decimal(18, 2)
  paymentDate   DateTime           @default(now())
  paymentMethod String             @default("Transfer")
  referenceNo   String?
  notes         String?
  createdAt     DateTime           @default(now())
  invoice       DistributorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentDate])
}

model IdempotencyRecord {
  id         String   @id @default(uuid())
  key        String   @unique
  path       String
  statusCode Int
  response   String   @db.Text
  createdAt  DateTime @default(now())

  @@index([key])
}
